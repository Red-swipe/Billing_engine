DATABASE_URL=sqlite:///./billing.db
APP_BASE_URL=http://localhost:8000

# Stripe test mode. Create a test key at https://dashboard.stripe.com/test/apikeys
# The Pro Price ID is the `price_...` id of a recurring monthly price in the
# same test-mode account. Both must be set for GET /checkout to work.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRO_PRICE_ID=price_replace_me

# Signing secret for POST /webhooks/stripe. With the Stripe CLI:
#   stripe listen --forward-to localhost:8000/webhooks/stripe
# then copy the `whsec_...` it prints.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
